# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtualenvs — uv creates .venv
.venv/
venv/

# uv — uv.lock is committed on purpose (reproducible container builds), do not add it here

# Secrets — every env file except the committed template
.env
.env.*
!.env.example

# Telethon / Pyrogram session files — these hold live account credentials
*.session
*.session-journal

# Docker Compose — local-only overrides (ports, mounts, dev creds)
docker-compose.override.yml
compose.override.yml

# PostgreSQL — local volume mounts and dumps.
# Note: migrations/*.sql stay tracked, only compressed dumps are ignored.
pgdata/
postgres-data/
postgres_data/
*.dump
*.sql.gz

# Tests & coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Ruff
.ruff_cache/

# Logs
*.log
logs/

# Claude Code — shared settings are committed, these are not
.claude/settings.local.json
.claude/worktrees/

# Editors
.idea/
.vscode/

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
